# jarvis-logs server configuration
# Service URLs are resolved automatically from jarvis-config-service
LOKI_URL=http://loki:7032
LOG_SERVER_PORT=7702

# Node authentication (required for nodes to send logs via /node/logs)
# Register jarvis-logs as an app client in jarvis-auth and set these:
JARVIS_APP_ID=jarvis-logs
JARVIS_APP_KEY=your-jarvis-logs-app-key
