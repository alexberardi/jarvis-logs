# jarvis-logs server configuration
LOKI_URL=http://loki:3100
LOG_SERVER_PORT=8006

# App-to-app authentication (required for services to send logs)
JARVIS_AUTH_BASE_URL=http://jarvis-auth:8007

# Node authentication (required for nodes to send logs via /node/logs)
# Register jarvis-logs as an app client in jarvis-auth and set these:
JARVIS_LOGS_APP_ID=jarvis-logs
JARVIS_LOGS_APP_KEY=your-jarvis-logs-app-key
